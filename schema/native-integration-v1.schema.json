{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ElliotGarbus/native-integration/main/schema/native-integration-v1.schema.json",
  "title": "native-integration sidecar, contract 1",
  "description": "Structural validation only. Namespace containment, cross-reference resolution, closure-wide collision detection and path escape are SPEC.md \u00a78's and are not expressible here; passing this schema is not conformance.",
  "type": "object",
  "required": [
    "contract"
  ],
  "additionalProperties": {
    "type": "object"
  },
  "properties": {
    "contract": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$"
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "android",
          "ios"
        ]
      },
      "minItems": 1
    },
    "android": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_sdk": {
              "type": "integer"
            },
            "compile_sdk": {
              "type": "integer"
            },
            "target_sdk": {
              "type": "integer"
            },
            "core_library_desugaring": {
              "const": true
            },
            "application_value": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "manifest_meta_data",
                      "manifest_placeholder",
                      "inline"
                    ]
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "placeholder": {
                    "type": "string",
                    "minLength": 1
                  },
                  "conditional": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "reason"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "inline"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": true,
                    "else": {
                      "required": [
                        "key"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "inline"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "not": {
                        "required": [
                          "key"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "usage_description"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "properties": {
                        "key": {
                          "pattern": "^.*UsageDescription$"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "info_plist"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "properties": {
                        "key": {
                          "not": {
                            "pattern": "^.*UsageDescription$"
                          }
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "info_plist"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "properties": {
                        "key": {
                          "not": {
                            "enum": [
                              "CFBundleIdentifier",
                              "CFBundleShortVersionString",
                              "CFBundleURLTypes",
                              "CFBundleVersion",
                              "MinimumOSVersion",
                              "NSUserActivityTypes",
                              "UIBackgroundModes",
                              "UIRequiredDeviceCapabilities"
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              }
            },
            "application_action": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "instructions": {
                    "type": "string",
                    "minLength": 1
                  },
                  "acceptance": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "uses": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "slot": {
                    "type": "string",
                    "minLength": 1
                  },
                  "conditional": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "summary",
                  "reason"
                ]
              }
            }
          }
        },
        "owns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "java_namespaces": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "contributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "src": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "java": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "kotlin": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "gradle_dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "coordinate": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!.*(-SNAPSHOT|\\+|latest\\.|\\[|\\]|\\(|\\)|,))[^:\\s]+:[^:\\s]+:[^:\\s]+$"
                  },
                  "module": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^:\\s]+:[^:\\s]+$"
                  },
                  "version": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "at_least": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^(?!.*(-SNAPSHOT|\\+|latest\\.))[0-9A-Za-z][0-9A-Za-z._-]*$"
                      },
                      "below": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^(?!.*(-SNAPSHOT|\\+|latest\\.))[0-9A-Za-z][0-9A-Za-z._-]*$"
                      }
                    },
                    "required": [
                      "at_least",
                      "below"
                    ]
                  },
                  "configuration": {
                    "enum": [
                      "implementation",
                      "api",
                      "compileOnly",
                      "runtimeOnly"
                    ]
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "coordinate"
                    ]
                  },
                  {
                    "required": [
                      "module"
                    ]
                  }
                ],
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "module"
                      ]
                    },
                    "then": {
                      "required": [
                        "version"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "version"
                      ]
                    },
                    "then": {
                      "not": {
                        "required": [
                          "coordinate"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "gradle_repositories": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/@]+(/.*)?$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "groups": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "modules": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "credentials_required": {
                    "type": "boolean"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "groups"
                    ]
                  },
                  {
                    "required": [
                      "modules"
                    ]
                  }
                ],
                "required": [
                  "url",
                  "reason"
                ]
              }
            },
            "permissions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "max_sdk_version": {
                    "type": "integer"
                  },
                  "never_for_location": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "features": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required": false
                },
                "required": [
                  "name"
                ]
              }
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "service",
                      "activity",
                      "receiver"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "from_dependency": {
                    "type": "string",
                    "minLength": 1
                  },
                  "foreground_service_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "exported_required": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "exported": false,
                  "view_links": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/$defs/stringOrInlineValue"
                      },
                      "properties": {
                        "scheme": {
                          "$ref": "#/$defs/stringOrInlineValue"
                        }
                      },
                      "propertyNames": {
                        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
                      },
                      "required": [
                        "scheme"
                      ]
                    }
                  },
                  "intent_filters": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "action": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "action"
                      ]
                    }
                  }
                },
                "required": [
                  "kind",
                  "name"
                ],
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "exported_required"
                      ]
                    },
                    "then": {
                      "required": [
                        "reason"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "foreground_service_type"
                      ]
                    },
                    "then": {
                      "properties": {
                        "kind": {
                          "const": "service"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "view_links"
                      ]
                    },
                    "then": {
                      "properties": {
                        "kind": {
                          "const": "activity"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "view_links"
                      ]
                    },
                    "then": {
                      "properties": {
                        "exported_required": {
                          "const": true
                        }
                      },
                      "required": [
                        "exported_required"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "intent_filters"
                      ]
                    },
                    "then": {
                      "not": {
                        "required": [
                          "exported_required"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "intent_filters"
                      ]
                    },
                    "then": {
                      "not": {
                        "required": [
                          "view_links"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "r8": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "keep_classes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "keep": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "pattern": {
                        "type": "string",
                        "minLength": 1
                      },
                      "from_dependency": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "pattern",
                      "from_dependency"
                    ]
                  }
                }
              }
            },
            "meta_data": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": [
                      "string",
                      "integer",
                      "boolean"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "key",
                  "value",
                  "reason"
                ]
              }
            },
            "queries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "package": {
                    "type": "string",
                    "minLength": 1
                  },
                  "provider_authority": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "package"
                    ]
                  },
                  {
                    "required": [
                      "provider_authority"
                    ]
                  }
                ],
                "required": [
                  "reason"
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "contributes"
                ],
                "properties": {
                  "contributes": {
                    "required": [
                      "src"
                    ],
                    "properties": {
                      "src": {
                        "required": [
                          "java"
                        ]
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "contributes"
                ],
                "properties": {
                  "contributes": {
                    "required": [
                      "src"
                    ],
                    "properties": {
                      "src": {
                        "required": [
                          "kotlin"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "owns"
            ],
            "properties": {
              "owns": {
                "required": [
                  "java_namespaces"
                ]
              }
            }
          }
        }
      ]
    },
    "ios": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deployment_target": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
            },
            "application_value": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "info_plist",
                      "usage_description",
                      "inline"
                    ]
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "placeholder": {
                    "type": "string",
                    "minLength": 1
                  },
                  "conditional": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "reason"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "inline"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": true,
                    "else": {
                      "required": [
                        "key"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "inline"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "not": {
                        "required": [
                          "key"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "usage_description"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "properties": {
                        "key": {
                          "pattern": "^.*UsageDescription$"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "info_plist"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "properties": {
                        "key": {
                          "not": {
                            "pattern": "^.*UsageDescription$"
                          }
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "info_plist"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "then": {
                      "properties": {
                        "key": {
                          "not": {
                            "enum": [
                              "CFBundleIdentifier",
                              "CFBundleShortVersionString",
                              "CFBundleURLTypes",
                              "CFBundleVersion",
                              "MinimumOSVersion",
                              "NSUserActivityTypes",
                              "UIBackgroundModes",
                              "UIRequiredDeviceCapabilities"
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              }
            },
            "application_action": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "instructions": {
                    "type": "string",
                    "minLength": 1
                  },
                  "acceptance": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "uses": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "slot": {
                    "type": "string",
                    "minLength": 1
                  },
                  "conditional": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "summary",
                  "reason"
                ]
              }
            }
          }
        },
        "contributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "swift_packages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^/@]+(/.*)?$"
                  },
                  "products": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "requirement": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "exact": {
                        "type": "string",
                        "minLength": 1
                      },
                      "from": {
                        "type": "string",
                        "minLength": 1
                      },
                      "revision": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "minProperties": 1,
                    "maxProperties": 1
                  },
                  "credentials_required": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "url",
                  "products",
                  "requirement"
                ],
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "credentials_required"
                      ]
                    },
                    "then": {
                      "required": [
                        "reason"
                      ]
                    }
                  }
                ]
              }
            },
            "src": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "swift": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "symbol_prefixes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": [
                      "symbol_prefixes"
                    ]
                  },
                  "then": {
                    "required": [
                      "swift"
                    ]
                  }
                }
              ]
            },
            "accessed_api_types": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reasons": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "reasons"
                ]
              }
            },
            "info_plist": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "values": {
                  "type": "object",
                  "propertyNames": {
                    "not": {
                      "anyOf": [
                        {
                          "enum": [
                            "CFBundleIdentifier",
                            "CFBundleShortVersionString",
                            "CFBundleURLTypes",
                            "CFBundleVersion",
                            "MinimumOSVersion",
                            "NSUserActivityTypes",
                            "SKAdNetworkItems",
                            "UIBackgroundModes",
                            "UIRequiredDeviceCapabilities"
                          ]
                        },
                        {
                          "pattern": "UsageDescription$"
                        }
                      ]
                    }
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/plistScalar"
                  }
                },
                "append": {
                  "type": "object",
                  "propertyNames": {
                    "not": {
                      "anyOf": [
                        {
                          "enum": [
                            "CFBundleIdentifier",
                            "CFBundleShortVersionString",
                            "CFBundleURLTypes",
                            "CFBundleVersion",
